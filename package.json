{
  "name": "electronfuckery",
  "description": "Hehe",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "build": {
    "appId": "dev.laratheprotogen.electronfuckery",
    "mac": {
      "category": "public.app-category.utilities"
    },
    "linux": {
      "category": "Network"
    }
  },
  "author": {
    "email": "laraproto@proton.me",
    "name": "Lara",
    "url": "https://laratheprotogen.dev"
  },
  "main": "packages/entry-point.mjs",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=23.0.0"
  },
  "scripts": {
    "build": "pnpm run -F \"@app/*\" build",
    "compile": "pnpm run build && electron-builder build --config electron-builder.mjs",
    "test": "pnpx playwright test ./tests/e2e.spec.ts",
    "start": "node packages/dev-mode.js",
    "typecheck": "pnpm run typecheck -ws --if-present",
    "create-renderer": "cd packages && node ./integrate-renderer/create-renderer.js",
    "integrate-renderer": "pnpm start --workspace @app/integrate-renderer",
    "init": "pnpm run create-renderer && pnpm run integrate-renderer && pnpm install --ignore-scripts"
  },
  "devDependencies": {
    "@npmcli/map-workspaces": "^6.0.0",
    "@playwright/test": "1.58.2",
    "@types/node": "25.5.0",
    "create-vite": "9.0.3",
    "dmg-license": "^1.0.11",
    "electron": "41.10.3",
    "electron-builder": "26.8.1",
    "glob": "13.0.6",
    "playwright": "^1.58.2"
  },
  "dependencies": {
    "@app/main": "workspace:*"
  },
  "allowScripts": {
    "electron@41.0.3": true,
    "electron-winstaller@5.4.0": true,
    "globals": true
  }
}
