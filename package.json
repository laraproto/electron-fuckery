{
  "name": "electronfuckery",
  "desktopName": "Electron Fuckery",
  "description": "uwu",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "build": {
    "appId": "dev.laratheprotogen.electronfuckery",
    "desktopName": "Electron Fuckery",
    "mac": {
      "category": "public.app-category.utilities"
    },
    "linux": {
      "category": "Network"
    }
  },
  "author": {
    "email": "laraproto@proton.me",
    "name": "Lara",
    "url": "https://laratheprotogen.dev"
  },
  "main": "packages/entry-point.mjs",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=23.0.0"
  },
  "scripts": {
    "build": "npm run build -ws --if-present",
    "compile": "npm run build && electron-builder build --config electron-builder.mjs",
    "test": "npx playwright test ./tests/e2e.spec.ts",
    "start": "node packages/dev-mode.js",
    "typecheck": "npm run typecheck -ws --if-present",
    "create-renderer": "cd packages && node ./integrate-renderer/create-renderer.js",
    "integrate-renderer": "npm start --workspace @app/integrate-renderer",
    "init": "npm run create-renderer && npm run integrate-renderer && npm install --ignore-scripts"
  },
  "devDependencies": {
    "@npmcli/map-workspaces": "^6.0.0",
    "@playwright/test": "1.58.2",
    "@types/node": "26.1.2",
    "create-vite": "9.0.3",
    "electron": "43.3.0",
    "electron-builder": "26.15.7",
    "glob": "13.0.6",
    "lightningcss": "^1.33.0",
    "playwright": "^1.58.2"
  },
  "dependencies": {
    "@app/main": "*"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
